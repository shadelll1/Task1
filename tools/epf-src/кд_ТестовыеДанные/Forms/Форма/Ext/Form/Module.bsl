&НаКлиенте
Процедура СоздатьТестовыеДанные(Команда)
	
	СоздатьТестовыеДанныеНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СоздатьТестовыеДанныеНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.СоздатьТестовыеДанные();
	
КонецПроцедуры

// Расширение, загруженное пакетно (load.bat), БСП еще не зарегистрировала.
// То же самое БСП делает сама при подключении .cfe через "Администрирование - Расширения".
&НаКлиенте
Процедура ОбновитьПараметрыРасширений(Команда)
	
	ОбновитьПараметрыРасширенийНаСервере();
	ПоказатьПредупреждение(, НСтр("ru = 'Параметры работы расширений обновлены. Перезапустите программу.'"));
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПараметрыРасширенийНаСервере()
	
	РегистрыСведений.ПараметрыРаботыВерсийРасширений.ОбновитьПараметрыРаботыРасширений();
	
КонецПроцедуры

// В учебной версии БП идентификаторы объектов расширений не регистрируются
// (Справочники.ИдентификаторыОбъектовМетаданных.ВыполнитьОбновлениеДанных сразу выходит
// для конфигурации "БухгалтерияПредприятияУчебная"), поэтому общая форма отчета БСП
// не может сформировать отчет расширения. Здесь тот же отчет формируется напрямую,
// по его схеме и варианту по умолчанию, и показывается табличным документом.
&НаКлиенте
Процедура СформироватьОтчет(Команда)
	
	Результат = СформироватьОтчетНаСервере();
	Результат.Показать(НСтр("ru = 'Просроченная дебиторская задолженность'"));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьОтчетНаСервере()
	
	Отчет = Отчеты.кд_ПросроченнаяДебиторскаяЗадолженность.Создать();
	Отчет.КомпоновщикНастроек.Инициализировать(
		Новый ИсточникДоступныхНастроекКомпоновкиДанных(Отчет.СхемаКомпоновкиДанных));
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Отчет.СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
	ДокументРезультат = Новый ТабличныйДокумент;
	Отчет.СкомпоноватьРезультат(ДокументРезультат);
	
	Возврат ДокументРезультат;
	
КонецФункции
