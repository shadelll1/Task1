// Внешняя обработка для проверки BUH-214: создает тестовые данные в демо-базе БП 3.0.
// Не входит в расширение, лежит в tools\. Запуск: testdata.bat -> кнопка "Создать тестовые данные".
//
// Создает (однократно - при повторном запуске ничего не дублирует):
//  - три покупателя с договорами;
//  - шесть проведенных реализаций с датами, попадающими во все интервалы просрочки;
//  - две частичные оплаты по конкретным реализациям;
//  - непроведенную реализацию для проверки блокировки;
//  - лимиты: у одного покупателя долг превышает лимит, у другого лимит 0.
// Реализации и оплаты копируются с проведенных документов демо-базы, чтобы счета учета,
// склад, подразделение и прочие реквизиты были заполнены так же, как у настоящих документов.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем Журнал; // Массив из Строка - строки журнала выполнения

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Создает тестовые данные и записывает журнал в файл рядом с проектом.
//
// Возвращаемое значение:
//  Строка - журнал выполнения.
//
Функция СоздатьТестовыеДанные() Экспорт

	Журнал = Новый Массив;
	Попытка
		ЗаполнитьБазу();
	Исключение
		ДобавитьВЖурнал("ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ТекстЖурнала = СтрСоединить(Журнал, Символы.ПС);
	ЗаписатьЖурнал(ТекстЖурнала);
	Возврат ТекстЖурнала;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьБазу()

	Если ТестовыеДанныеУжеСозданы() Тогда
		ДобавитьВЖурнал("Тестовые данные уже созданы ранее - ничего не делаю.");
		Возврат;
	КонецЕсли;

	ШаблонРеализации = ШаблонРеализацииУслуг();
	Организация = ШаблонРеализации.Организация;
	ШаблонОплаты = ШаблонОплатыПокупателя(Организация);
	ДобавитьВЖурнал("Шаблон реализации: " + ШаблонРеализации);
	ДобавитьВЖурнал("Шаблон оплаты: " + ШаблонОплаты);
	ДобавитьВЖурнал("Организация: " + Организация);

	ДатаОтчета = НачалоДня(ТекущаяДатаСеанса());

	НачатьТранзакцию();
	Попытка

		// Покупатель 1: срок оплаты в договоре не задан (действует срок по умолчанию 10 дней),
		// после создания данных долг превысит лимит.
		Ромашка = СоздатьПокупателя("Ромашка (тест КД)", "ООО ""Ромашка (тест КД)""");
		ДоговорРомашка = СоздатьДоговор(ШаблонРеализации.ДоговорКонтрагента, Ромашка, 0);

		// Покупатель 2: срок оплаты 20 дней, лимит 0 - контроль не выполняется.
		Лютик = СоздатьПокупателя("Лютик (тест КД)", "ООО ""Лютик (тест КД)""");
		ДоговорЛютик = СоздатьДоговор(ШаблонРеализации.ДоговорКонтрагента, Лютик, 20);

		// Покупатель 3: срок по умолчанию, долг в пределах лимита.
		Васильков = СоздатьПокупателя("Васильков (тест КД)", "ИП Васильков (тест КД)");
		ДоговорВасильков = СоздатьДоговор(ШаблонРеализации.ДоговорКонтрагента, Васильков, 0);

		// Ромашка: 5 дней (не просрочено), 30 дней (просрочка 20 - "1-30"), 55 дней (просрочка 45 - "31-60").
		СоздатьРеализацию(ШаблонРеализации, Ромашка, ДоговорРомашка, ДатаДокумента(ДатаОтчета, 5), 50000);
		СоздатьРеализацию(ШаблонРеализации, Ромашка, ДоговорРомашка, ДатаДокумента(ДатаОтчета, 30), 40000);
		РеализацияРомашка3 = СоздатьРеализацию(ШаблонРеализации, Ромашка, ДоговорРомашка,
			ДатаДокумента(ДатаОтчета, 55), 45000);
		СоздатьОплату(ШаблонОплаты, Ромашка, ДоговорРомашка, РеализацияРомашка3, ДатаДокумента(ДатаОтчета, 20), 15000);

		// Лютик (срок 20): 100 дней (просрочка 80 - "61-90"), 150 дней (просрочка 130 - "более 90").
		СоздатьРеализацию(ШаблонРеализации, Лютик, ДоговорЛютик, ДатаДокумента(ДатаОтчета, 100), 60000);
		СоздатьРеализацию(ШаблонРеализации, Лютик, ДоговорЛютик, ДатаДокумента(ДатаОтчета, 150), 25000);

		// Васильков: 40 дней (просрочка 30 - граница "1-30"), частично оплачена.
		РеализацияВасильков = СоздатьРеализацию(ШаблонРеализации, Васильков, ДоговорВасильков,
			ДатаДокумента(ДатаОтчета, 40), 70000);
		СоздатьОплату(ШаблонОплаты, Васильков, ДоговорВасильков, РеализацияВасильков,
			ДатаДокумента(ДатаОтчета, 10), 20000);

		// Черновик для ручной проверки блокировки: 120 000 + 15 400 = 135 400 > 100 000.
		СоздатьРеализацию(ШаблонРеализации, Ромашка, ДоговорРомашка, ДатаОтчета + 18 * 3600, 15400, Ложь);

		// Лимиты задаем после проведения, иначе контроль не дал бы создать долг сверх лимита.
		УстановитьЛимит(Ромашка, 100000);
		УстановитьЛимит(Лютик, 0);
		УстановитьЛимит(Васильков, 300000);

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ДобавитьВЖурнал("OK: тестовые данные созданы. Дата отчета: " + Формат(ДатаОтчета, "ДЛФ=D"));

КонецПроцедуры

Функция ТестовыеДанныеУжеСозданы()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование ПОДОБНО ""%(тест КД)%""";
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция ШаблонРеализацииУслуг()

	// Проведенная рублевая реализация только с услугами: при копировании не нужны остатки товаров.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Реализация.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|	Реализация.Проведен
	|	И НЕ Реализация.ПометкаУдаления
	|	И Реализация.СчетУчетаРасчетовСКонтрагентом = &СчетРасчетов
	|	И Реализация.ДоговорКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
	|	И ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				Документ.РеализацияТоваровУслуг.Услуги КАК Услуги
	|			ГДЕ
	|				Услуги.Ссылка = Реализация.Ссылка)
	|	И НЕ ИСТИНА В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ИСТИНА
	|				ИЗ
	|					Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|				ГДЕ
	|					Товары.Ссылка = Реализация.Ссылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Реализация.Дата УБЫВ";
	Запрос.УстановитьПараметр("СчетРасчетов", ПланыСчетов.Хозрасчетный.РасчетыСПокупателями);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "В базе нет проведенной реализации услуг покупателю - не с чего копировать.";
	КонецЕсли;
	Возврат Выборка.Ссылка;

КонецФункции

Функция ШаблонОплатыПокупателя(Организация)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Поступление.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеНаРасчетныйСчет КАК Поступление
	|ГДЕ
	|	Поступление.Проведен
	|	И НЕ Поступление.ПометкаУдаления
	|	И Поступление.Организация = &Организация
	|	И Поступление.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеДенежныхСредств.ОплатаПокупателя)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поступление.Дата УБЫВ";
	Запрос.УстановитьПараметр("Организация", Организация);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "В базе нет проведенной оплаты покупателя - не с чего копировать.";
	КонецЕсли;
	Возврат Выборка.Ссылка;

КонецФункции

Функция СоздатьПокупателя(Наименование, НаименованиеПолное)

	Покупатель = Справочники.Контрагенты.СоздатьЭлемент();
	Покупатель.Наименование = Наименование;
	Покупатель.НаименованиеПолное = НаименованиеПолное;
	Покупатель.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
	Покупатель.Комментарий = "Тестовые данные BUH-214";
	Покупатель.Записать();

	ДобавитьВЖурнал("Контрагент: " + Покупатель.Наименование);
	Возврат Покупатель.Ссылка;

КонецФункции

Функция СоздатьДоговор(ДоговорШаблон, Владелец, СрокОплаты)

	Договор = ДоговорШаблон.ПолучитьОбъект().Скопировать();
	Договор.Владелец = Владелец;
	Договор.Наименование = "Основной договор (тест КД)";
	Договор.Номер = "КД-" + Формат(СрокОплаты, "ЧН=0; ЧГ=0");
	Договор.УстановленСрокОплаты = СрокОплаты > 0;
	Договор.СрокОплаты = СрокОплаты;
	Договор.Записать();

	Возврат Договор.Ссылка;

КонецФункции

Функция СоздатьРеализацию(Шаблон, Контрагент, Договор, Дата, Сумма, Провести = Истина)

	Документ = Шаблон.ПолучитьОбъект().Скопировать();
	Документ.Дата = Дата;
	Документ.УстановитьНовыйНомер();
	Документ.Контрагент = Контрагент;
	Документ.ДоговорКонтрагента = Договор;
	Документ.СчетНаОплатуПокупателю = Документы.СчетНаОплатуПокупателю.ПустаяСсылка();
	Документ.Комментарий = "Тестовые данные BUH-214";
	Документ.СуммаВключаетНДС = Истина;

	// Оставляем одну строку услуг, остальные табличные части очищаем.
	СтрокаУслуг = Документ.Услуги[0];
	Для Каждого ТабличнаяЧасть Из Документ.Метаданные().ТабличныеЧасти Цикл
		Если ТабличнаяЧасть.Имя <> "Услуги" Тогда
			Документ[ТабличнаяЧасть.Имя].Очистить();
		КонецЕсли;
	КонецЦикла;
	Пока Документ.Услуги.Количество() > 1 Цикл
		Документ.Услуги.Удалить(Документ.Услуги.Количество() - 1);
	КонецЦикла;
	СтрокаУслуг.Количество = 1;
	СтрокаУслуг.Цена = Сумма;
	СтрокаУслуг.Сумма = Сумма;
	СтрокаУслуг.СуммаНДС = СуммаНДСВключенная(Сумма, СтрокаУслуг.СтавкаНДС);
	СтрокаУслуг.СчетНаОплатуПокупателю = Документы.СчетНаОплатуПокупателю.ПустаяСсылка();
	Документ.СуммаДокумента = Сумма;

	Если Провести Тогда
		Документ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Иначе
		Документ.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

	ДобавитьВЖурнал(СтрШаблон("Реализация %1 от %2: %3, %4, проведена: %5",
		Документ.Номер, Формат(Документ.Дата, "ДЛФ=D"), Контрагент, Сумма, Провести));
	Возврат Документ.Ссылка;

КонецФункции

Процедура СоздатьОплату(Шаблон, Контрагент, Договор, Реализация, Дата, Сумма)

	Документ = Шаблон.ПолучитьОбъект().Скопировать();
	СтрокаШаблона = Документ.РасшифровкаПлатежа[0];
	СтатьяДДС = СтрокаШаблона.СтатьяДвиженияДенежныхСредств;
	СтавкаНДС = Реализация.Услуги[0].СтавкаНДС;

	Документ.Дата = Дата;
	Документ.УстановитьНовыйНомер();
	Документ.Контрагент = Контрагент;
	Документ.ДоговорКонтрагента = Договор;
	Документ.СчетКонтрагента = Неопределено;
	Документ.ДокументОснование = Неопределено;
	Документ.НомерВходящегоДокумента = "КД" + Формат(Сумма, "ЧГ=0");
	Документ.ДатаВходящегоДокумента = Дата;
	Документ.СуммаДокумента = Сумма;
	Документ.НазначениеПлатежа = "Оплата по реализации (тестовые данные BUH-214)";
	Документ.Комментарий = "Тестовые данные BUH-214";

	Документ.РасшифровкаПлатежа.Очистить();
	Строка = Документ.РасшифровкаПлатежа.Добавить();
	Строка.ДоговорКонтрагента = Договор;
	Строка.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.ПоДокументу;
	Строка.Сделка = Реализация;
	Строка.СуммаПлатежа = Сумма;
	Строка.СуммаВзаиморасчетов = Сумма;
	Строка.КурсВзаиморасчетов = 1;
	Строка.КратностьВзаиморасчетов = 1;
	Строка.СтавкаНДС = СтавкаНДС;
	Строка.СуммаНДС = СуммаНДСВключенная(Сумма, СтавкаНДС);
	Строка.СтатьяДвиженияДенежныхСредств = СтатьяДДС;
	Строка.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.РасчетыСПокупателями;
	Строка.СчетУчетаРасчетовПоАвансам = ПланыСчетов.Хозрасчетный.РасчетыПоАвансамПолученным;

	Документ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);

	ДобавитьВЖурнал(СтрШаблон("Оплата %1 от %2: %3, %4 по %5",
		Документ.Номер, Формат(Документ.Дата, "ДЛФ=D"), Контрагент, Сумма, Реализация));

КонецПроцедуры

Процедура УстановитьЛимит(Контрагент, Лимит)

	Объект = Контрагент.ПолучитьОбъект();
	Объект.кд_ЛимитЗадолженности = Лимит;
	Объект.кд_РазрешитьОтгрузкуСверхЛимита = Ложь;
	Объект.Записать();

	ДобавитьВЖурнал(СтрШаблон("Лимит %1: %2", Контрагент, Лимит));

КонецПроцедуры

Функция ДатаДокумента(ДатаОтчета, ДнейНазад)

	СекундВДне = 86400;
	ПолденьВСекундах = 12 * 3600;
	Возврат ДатаОтчета - ДнейНазад * СекундВДне + ПолденьВСекундах;

КонецФункции

Функция СуммаНДСВключенная(Сумма, СтавкаНДС)

	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Или СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
		Процент = 20;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18 Или СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
		Процент = 18;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10 Или СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
		Процент = 10;
	Иначе
		Процент = 0;
	КонецЕсли;

	Возврат Окр(Сумма * Процент / (100 + Процент), 2);

КонецФункции

Процедура ДобавитьВЖурнал(Текст)

	Журнал.Добавить(Текст);
	Сообщить(Текст);

КонецПроцедуры

Процедура ЗаписатьЖурнал(ТекстЖурнала)

	ИмяФайла = КаталогВременныхФайлов() + "kd_testdata.log";
	Попытка
		Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
		Запись.Записать(ТекстЖурнала);
		Запись.Закрыть();
	Исключение
		Сообщить("Не удалось записать журнал в файл " + ИмяФайла);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
