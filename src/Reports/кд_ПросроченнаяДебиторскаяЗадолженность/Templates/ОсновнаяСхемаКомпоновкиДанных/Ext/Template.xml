		<dataSource>ИсточникДанных1</dataSource>
		<query>// Остатки по счету 62.01 в разрезе контрагента, договора и документа расчетов.
// Единственное обращение к регистру бухгалтерии в отчете.
ВЫБРАТЬ
	Остатки.Организация КАК Организация,
	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ДоговорыКонтрагентов) КАК Договор,
	Остатки.Субконто3 КАК ДокументРасчетов,
	Остатки.СуммаОстаток КАК Сумма
ПОМЕСТИТЬ ВТ_Остатки
ИЗ
	РегистрБухгалтерии.Хозрасчетный.Остатки(
			&amp;ГраницаОстатков,
			Счет = &amp;СчетРасчетов,
			&amp;ВидыСубконто,
			Организация = &amp;Организация
				ИЛИ &amp;ВсеОрганизации) КАК Остатки
;

////////////////////////////////////////////////////////////////////////////////
// Дни просрочки: от даты документа расчетов + срок оплаты по договору до даты отчета.
// Дата документа берется из регистра ДанныеПервичныхДокументов, как в типовых отчетах БП.
ВЫБРАТЬ
	ВТ_Остатки.Контрагент КАК Контрагент,
	ВТ_Остатки.Договор КАК Договор,
	ВТ_Остатки.ДокументРасчетов КАК ДокументРасчетов,
	ВТ_Остатки.Сумма КАК Сумма,
	РАЗНОСТЬДАТ(
		ЕСТЬNULL(ВЫБОР
				КОГДА ДанныеПервичныхДокументов.Дата = ДАТАВРЕМЯ(1, 1, 1)
					ТОГДА ДанныеПервичныхДокументов.ДатаРегистратора
				ИНАЧЕ ДанныеПервичныхДокументов.Дата
			КОНЕЦ, &amp;ДатаОтчета),
		&amp;ДатаОтчета,
		ДЕНЬ) - ВЫБОР
		КОГДА ВТ_Остатки.Договор.УстановленСрокОплаты
				И ВТ_Остатки.Договор.СрокОплаты &gt; 0
			ТОГДА ВТ_Остатки.Договор.СрокОплаты
		ИНАЧЕ &amp;СрокОплатыПоУмолчанию
	КОНЕЦ КАК ДнейПросрочки
ПОМЕСТИТЬ ВТ_Долги
ИЗ
	ВТ_Остатки КАК ВТ_Остатки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПервичныхДокументов КАК ДанныеПервичныхДокументов
		ПО ВТ_Остатки.Организация = ДанныеПервичныхДокументов.Организация
			И ВТ_Остатки.ДокументРасчетов = ДанныеПервичныхДокументов.Документ
;

////////////////////////////////////////////////////////////////////////////////
// Общий долг контрагента - для сравнения с лимитом.
ВЫБРАТЬ
	ВТ_Долги.Контрагент КАК Контрагент,
	СУММА(ВТ_Долги.Сумма) КАК Долг
ПОМЕСТИТЬ ВТ_ДолгПоКонтрагентам
ИЗ
	ВТ_Долги КАК ВТ_Долги
СГРУППИРОВАТЬ ПО
	ВТ_Долги.Контрагент
;

////////////////////////////////////////////////////////////////////////////////
// Раскладка по интервалам просрочки. Кредитовые остатки по документам не распределяются
// по интервалам и попадают в "Не просрочено", чтобы итог совпадал с ОСВ.
ВЫБРАТЬ
	ВТ_Долги.Контрагент КАК Контрагент,
	ВТ_Долги.Договор КАК Договор,
	ВТ_Долги.ДокументРасчетов КАК ДокументРасчетов,
	ВЫБОР
		КОГДА ВТ_Долги.Сумма &lt;= 0
				ИЛИ ВТ_Долги.ДнейПросрочки &lt;= 0
			ТОГДА ВТ_Долги.Сумма
		ИНАЧЕ 0
	КОНЕЦ КАК НеПросрочено,
	ВЫБОР
		КОГДА ВТ_Долги.Сумма &gt; 0
				И ВТ_Долги.ДнейПросрочки &gt; 0
				И ВТ_Долги.ДнейПросрочки &lt;= &amp;ГраницаИнтервала1
			ТОГДА ВТ_Долги.Сумма
		ИНАЧЕ 0
	КОНЕЦ КАК ПросроченоИнтервал1,
	ВЫБОР
		КОГДА ВТ_Долги.Сумма &gt; 0
				И ВТ_Долги.ДнейПросрочки &gt; &amp;ГраницаИнтервала1
				И ВТ_Долги.ДнейПросрочки &lt;= &amp;ГраницаИнтервала2
			ТОГДА ВТ_Долги.Сумма
		ИНАЧЕ 0
	КОНЕЦ КАК ПросроченоИнтервал2,
	ВЫБОР
		КОГДА ВТ_Долги.Сумма &gt; 0
				И ВТ_Долги.ДнейПросрочки &gt; &amp;ГраницаИнтервала2
				И ВТ_Долги.ДнейПросрочки &lt;= &amp;ГраницаИнтервала3
			ТОГДА ВТ_Долги.Сумма
		ИНАЧЕ 0
	КОНЕЦ КАК ПросроченоИнтервал3,
	ВЫБОР
		КОГДА ВТ_Долги.Сумма &gt; 0
				И ВТ_Долги.ДнейПросрочки &gt; &amp;ГраницаИнтервала3
			ТОГДА ВТ_Долги.Сумма
		ИНАЧЕ 0
	КОНЕЦ КАК ПросроченоИнтервал4,
	ВТ_Долги.Сумма КАК Итого,
	ВТ_Долги.Контрагент.кд_ЛимитЗадолженности КАК Лимит,
	ВЫБОР
		КОГДА ВТ_Долги.Контрагент.кд_ЛимитЗадолженности &gt; 0
				И ВТ_ДолгПоКонтрагентам.Долг &gt; ВТ_Долги.Контрагент.кд_ЛимитЗадолженности
			ТОГДА ВТ_ДолгПоКонтрагентам.Долг - ВТ_Долги.Контрагент.кд_ЛимитЗадолженности
		ИНАЧЕ 0
	КОНЕЦ КАК ПревышениеЛимита
ИЗ
	ВТ_Долги КАК ВТ_Долги
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДолгПоКонтрагентам КАК ВТ_ДолгПоКонтрагентам
		ПО ВТ_Долги.Контрагент = ВТ_ДолгПоКонтрагентам.Контрагент</query>
	</dataSet>
