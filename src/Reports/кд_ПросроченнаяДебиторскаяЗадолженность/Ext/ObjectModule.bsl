#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Формирует отчет "Просроченная дебиторская задолженность".
//
// Стандартная компоновка заменена на явную, чтобы до выполнения запроса подставить служебные
// параметры, которые пользователь не задает: границу остатков (конец дня даты отчета, как в ОСВ)
// и признак отбора по всем организациям. Сам запрос к регистру бухгалтерии
// выполняется один раз на весь отчет.
//
// Параметры:
//  ДокументРезультат - ТабличныйДокумент - документ, в который выводится отчет.
//  ДанныеРасшифровки - ДанныеРасшифровкиКомпоновкиДанных - данные расшифровки.
//  СтандартнаяОбработка - Булево - признак стандартной обработки события.
//
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Настройки = КомпоновщикНастроек.ПолучитьНастройки();

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);

	ЗаполнитьСлужебныеПараметры(МакетКомпоновки, Настройки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет значения параметров макета, вычисляемые по пользовательским настройкам.
//
// Параметры:
//  МакетКомпоновки - МакетКомпоновкиДанных - макет, полученный компоновщиком макета.
//  Настройки - НастройкиКомпоновкиДанных - настройки, по которым формируется отчет.
//
Процедура ЗаполнитьСлужебныеПараметры(МакетКомпоновки, Настройки)
	
	ИменаПараметров = ИменаПараметровСхемы();
	
	ДатаОтчета = ЗначениеПараметраНастроек(Настройки, ИменаПараметров.ДатаОтчета);
	Если Не ЗначениеЗаполнено(ДатаОтчета) Тогда
		ДатаОтчета = ТекущаяДатаСеанса();
	КонецЕсли;
	ДатаОтчета = НачалоДня(ДатаОтчета);
	
	Организация = ЗначениеПараметраНастроек(Настройки, ИменаПараметров.Организация);
	ВсеОрганизации = Не ЗначениеЗаполнено(Организация);
	Если ВсеОрганизации Тогда
		Организация = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	// Остатки на конец дня отчета включительно - так же, как их показывает ОСВ по счету 62.01.
	ГраницаОстатков = Новый Граница(КонецДня(ДатаОтчета), ВидГраницы.Включая);
	
	УстановитьЗначениеПараметраМакета(МакетКомпоновки, ИменаПараметров.ДатаОтчета, ДатаОтчета);
	УстановитьЗначениеПараметраМакета(МакетКомпоновки, ИменаПараметров.Организация, Организация);
	УстановитьЗначениеПараметраМакета(МакетКомпоновки, ИменаПараметров.ВсеОрганизации, ВсеОрганизации);
	УстановитьЗначениеПараметраМакета(МакетКомпоновки, ИменаПараметров.ГраницаОстатков, ГраницаОстатков);
	
КонецПроцедуры

// Возвращает значение параметра данных из настроек, если параметр используется.
//
// Параметры:
//  Настройки - НастройкиКомпоновкиДанных - настройки отчета.
//  ИмяПараметра - Строка - имя параметра данных.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - значение параметра; Неопределено, если параметр не используется.
//
Функция ЗначениеПараметраНастроек(Настройки, ИмяПараметра)

	ЗначениеПараметра = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных(ИмяПараметра));

	Если ЗначениеПараметра = Неопределено Или Не ЗначениеПараметра.Использование Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЗначениеПараметра.Значение;

КонецФункции

// Устанавливает значение параметра макета компоновки, если параметр используется в макете.
//
// Параметры:
//  МакетКомпоновки - МакетКомпоновкиДанных - макет компоновки.
//  ИмяПараметра - Строка - имя параметра.
//  Значение - Произвольный - значение параметра.
//
Процедура УстановитьЗначениеПараметраМакета(МакетКомпоновки, ИмяПараметра, Значение)

	ПараметрМакета = МакетКомпоновки.ЗначенияПараметров.Найти(ИмяПараметра);
	Если ПараметрМакета <> Неопределено Тогда
		ПараметрМакета.Значение = Значение;
	КонецЕсли;

КонецПроцедуры

// Имена параметров схемы компоновки, которые заполняются программно.
//
// Возвращаемое значение:
//  Структура - ключ и значение совпадают с именем параметра схемы:
//   * ДатаОтчета - Строка - дата, на которую считаются остатки и просрочка.
//   * Организация - Строка - отбор по организации (пусто - все организации).
//   * ВсеОрганизации - Строка - признак отсутствия отбора по организации.
//   * ГраницаОстатков - Строка - граница виртуальной таблицы остатков.
//
Функция ИменаПараметровСхемы()
	
	ИменаПараметров = Новый Структура;
	Для Каждого ИмяПараметра Из СтрРазделить("ДатаОтчета,Организация,ВсеОрганизации,ГраницаОстатков", ",") Цикл
		ИменаПараметров.Вставить(ИмяПараметра, ИмяПараметра);
	КонецЦикла;
	
	Возврат ИменаПараметров;
	
КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
