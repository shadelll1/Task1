#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Перехват типовой процедуры ОбработкаПроведения (BUH-214).
//
// Выполняется после типового проведения: на сервере, в транзакции проведения и при любом способе
// проведения (из формы, из списка, обработками). Установка Отказ откатывает проведение целиком.
// Типовой код не изменяется, конфигурация остается на поддержке.
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения.
//
&После("ОбработкаПроведения")
Процедура кд_ОбработкаПроведенияПосле(Отказ, РежимПроведения)

	// Типовое проведение уже отказало - дополнительная проверка не нужна.
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// Групповое перепроведение (закрытие месяца, восстановление последовательности) - это не новая
	// отгрузка. Контроль лимита не выполняем, чтобы не блокировать регламентные операции.
	Если ПроведениеСервер.ГрупповоеПерепроведение(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;

	кд_КонтрольКредитногоЛимита.ПроверитьКредитныйЛимитПриПроведении(ЭтотОбъект, Отказ);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
