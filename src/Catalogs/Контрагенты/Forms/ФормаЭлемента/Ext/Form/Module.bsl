// Модуль заимствованной формы Справочник.Контрагенты.ФормаЭлемента (расширение БП_КонтрольДолгов).
//
// Группа "Кредитный лимит" создается программно, а не в редакторе формы: так расширение
// не зависит от расположения элементов типовой формы и переживает обновления БП.

&НаСервере
&После("ПриСозданииНаСервере")
Процедура кд_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	кд_ДобавитьГруппуКредитныйЛимит();

КонецПроцедуры

// Добавляет на форму группу "Кредитный лимит" с реквизитами расширения.
//
&НаСервере
Процедура кд_ДобавитьГруппуКредитныйЛимит()

	Группа = Элементы.Добавить("кд_ГруппаКредитныйЛимит", Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Заголовок = НСтр("ru = 'Кредитный лимит'");
	Группа.ОтображатьЗаголовок = Истина;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;

	ПолеЛимит = Элементы.Добавить("кд_ЛимитЗадолженности", Тип("ПолеФормы"), Группа);
	ПолеЛимит.Вид = ВидПоляФормы.ПолеВвода;
	ПолеЛимит.ПутьКДанным = "Объект.кд_ЛимитЗадолженности";

	ПолеРазрешить = Элементы.Добавить("кд_РазрешитьОтгрузкуСверхЛимита", Тип("ПолеФормы"), Группа);
	ПолеРазрешить.Вид = ВидПоляФормы.ПолеФлажка;
	ПолеРазрешить.ПутьКДанным = "Объект.кд_РазрешитьОтгрузкуСверхЛимита";
	ПолеРазрешить.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;

КонецПроцедуры
