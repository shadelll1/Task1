///////////////////////////////////////////////////////////////////////////////////////////////////////
// Расширение БП_КонтрольДолгов (BUH-214).
// Контроль кредитного лимита покупателя при проведении реализации.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверяет, не превысит ли задолженность покупателя его кредитный лимит после проведения реализации.
// Вызывается из перехватчика ОбработкаПроведения документа РеализацияТоваровУслуг.
//
// Долг с учетом документа = сальдо счета 62.01 по контрагенту и организации на момент времени документа
// (движения самого документа не учитываются) + сумма документа.
// Если лимит равен 0 или у контрагента разрешена отгрузка сверх лимита, контроль не выполняется.
// Пользователю с ролью кд_ОтгрузкаСверхЛимита выводится только предупреждение, проведение не отменяется.
//
// Параметры:
//  Документ - ДокументОбъект.РеализацияТоваровУслуг - проводимый документ.
//  Отказ    - Булево - выходной параметр: устанавливается в Истина, если проведение нужно отменить.
//
Процедура ПроверитьКредитныйЛимитПриПроведении(Документ, Отказ) Экспорт

	Если Не ЗначениеЗаполнено(Документ.Контрагент) Тогда
		Возврат;
	КонецЕсли;

	НастройкиЛимита = НастройкиКредитногоЛимита(Документ.Контрагент);
	Если Не КонтрольЛимитаВыполняется(НастройкиЛимита) Тогда
		Возврат;
	КонецЕсли;

	ДолгСУчетомДокумента = ДолгКонтрагентаДоДокумента(Документ) + Документ.СуммаДокумента;
	Если ДолгСУчетомДокумента <= НастройкиЛимита.Лимит Тогда
		Возврат;
	КонецЕсли;

	ТекстПревышения = ТекстСообщенияОПревышении(Документ.Контрагент,
		НастройкиЛимита.Лимит, ДолгСУчетомДокумента);

	Если ОтгрузкаСверхЛимитаРазрешенаПользователю() Тогда
		ТекстПредупреждения = СтрШаблон(
			НСтр("ru = 'Внимание! %1. Документ проведен: у вас есть право отгрузки сверх лимита.'"),
			ТекстПревышения);
		ОбщегоНазначения.СообщитьПользователю(ТекстПредупреждения, Документ, ИмяПоляКонтрагент());
	Иначе
		ОбщегоНазначения.СообщитьПользователю(ТекстПревышения, Документ, ИмяПоляКонтрагент(), , Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает настройки кредитного лимита контрагента.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - покупатель.
//
// Возвращаемое значение:
//  Структура - настройки лимита:
//   * Лимит - Число - лимит задолженности; 0 - контроль не выполняется.
//   * РазрешитьОтгрузкуСверхЛимита - Булево - отгрузка сверх лимита разрешена для контрагента.
//
Функция НастройкиКредитногоЛимита(Контрагент)

	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент,
		"кд_ЛимитЗадолженности, кд_РазрешитьОтгрузкуСверхЛимита");

	Настройки = Новый Структура;
	Настройки.Вставить("Лимит", ЗначенияРеквизитов.кд_ЛимитЗадолженности);
	Настройки.Вставить("РазрешитьОтгрузкуСверхЛимита", ЗначенияРеквизитов.кд_РазрешитьОтгрузкуСверхЛимита);

	Возврат Настройки;

КонецФункции

// Определяет, нужно ли контролировать лимит для контрагента.
//
// Параметры:
//  НастройкиЛимита - см. НастройкиКредитногоЛимита.
//
// Возвращаемое значение:
//  Булево - Истина, если лимит задан и отгрузка сверх лимита для контрагента не разрешена.
//
Функция КонтрольЛимитаВыполняется(НастройкиЛимита)

	// Нулевой (незаполненный) лимит означает "без ограничений" - документ проводится как раньше.
	Возврат ЗначениеЗаполнено(НастройкиЛимита.Лимит)
		И Не НастройкиЛимита.РазрешитьОтгрузкуСверхЛимита;

КонецФункции

// Возвращает сальдо по счету 62.01 по контрагенту и организации документа
// на момент времени документа, не включая движения самого документа.
//
// Граница "Исключая" по моменту времени документа отсекает его собственные движения.
// Поэтому при повторном проведении сумма документа не учитывается дважды,
// и результат не зависит от того, отложено ли в базе проведение расчетов с контрагентами.
// Выполняется ровно один запрос к регистру бухгалтерии на документ.
//
// Параметры:
//  Документ - ДокументОбъект.РеализацияТоваровУслуг - проводимый документ.
//
// Возвращаемое значение:
//  Число - задолженность контрагента до документа (Дт - Кт).
//
Функция ДолгКонтрагентаДоДокумента(Документ)

	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК Долг
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&Граница,
	|			Счет = &СчетРасчетов,
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И Субконто1 = &Контрагент) КАК Остатки";

	Запрос.УстановитьПараметр("Граница", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СчетРасчетов", ПланыСчетов.Хозрасчетный.РасчетыСПокупателями);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("Организация", Документ.Организация);
	Запрос.УстановитьПараметр("Контрагент", Документ.Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Долг;

КонецФункции

// Определяет, разрешено ли текущему пользователю проводить отгрузку сверх лимита.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователю назначена роль кд_ОтгрузкаСверхЛимита.
//
Функция ОтгрузкаСверхЛимитаРазрешенаПользователю()

	Возврат РольДоступна(Метаданные.Роли.кд_ОтгрузкаСверхЛимита);

КонецФункции

// Формирует текст сообщения о превышении кредитного лимита.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - покупатель.
//  Лимит - Число - лимит задолженности.
//  ДолгСУчетомДокумента - Число - задолженность с учетом проводимого документа.
//
// Возвращаемое значение:
//  Строка - текст сообщения.
//
Функция ТекстСообщенияОПревышении(Контрагент, Лимит, ДолгСУчетомДокумента)

	Возврат СтрШаблон(
		НСтр("ru = 'Превышен кредитный лимит контрагента %1: лимит %2, долг с учетом документа %3'"),
		Контрагент,
		Формат(Лимит, ФорматСуммы()),
		Формат(ДолгСУчетомДокумента, ФорматСуммы()));

КонецФункции

// Возвращаемое значение:
//  Строка - форматная строка для вывода сумм в сообщениях ("100 000,00").
//
Функция ФорматСуммы()

	Возврат "ЧДЦ=2; ЧН=0,00";

КонецФункции

// Возвращаемое значение:
//  Строка - имя реквизита документа, к которому привязывается сообщение о превышении.
//
Функция ИмяПоляКонтрагент()

	Возврат "Контрагент";

КонецФункции

#КонецОбласти
